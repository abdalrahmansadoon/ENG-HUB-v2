# انسخ هذا الملف إلى .env.local وضع قيم مشروع Firebase الجديد.
# إذا تركت القيم فارغة يعمل الموقع في "الوضع التجريبي" ببيانات محفوظة في المتصفح.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (قيم عامة). الـ preset يجب أن يكون Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
